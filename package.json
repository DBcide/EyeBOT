    "migrate:rollback": "ts-node src/scripts/rollback-migration.ts",
    "migrate:list": "ts-node src/scripts/list-migrations.ts",
    "download:assets": "node download-weapon-assets.js",
    "test": "jest",
    "test:coverage": "jest --coverage --passWithNoTests"
  },
  "author": "Olivier Français (DBcide)",
  "license": "ISC",
  "dependencies": {
    "discord.js": "^14.25.1",
    "dotenv": "^16.6.1",
    "mysql2": "^3.16.0"
  },
  "supportedArchitectures": {
    "os": ["win32", "linux", "darwin"],
    "cpu": ["x64", "arm64"],
    "libc": ["glibc", "musl"]
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.4",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
